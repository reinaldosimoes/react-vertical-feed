{
  "name": "react-vertical-feed",
  "version": "0.2.1",
  "description": "A small, accessible React component for TikTok-style vertical video feeds with scroll snap and autoplay",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && rollup -c",
    "dev": "vite",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:pack": "node scripts/verify-package.mjs",
    "test:release": "npm test -- --runInBand && npm run lint && npm run build && npm run size && npm run test:pack && npm audit --audit-level=high",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "release": "standard-version && npm run publish-release",
    "release:minor": "standard-version --release-as minor && npm run publish-release",
    "release:major": "standard-version --release-as major && npm run publish-release",
    "release:patch": "standard-version --release-as patch && npm run publish-release",
    "publish-release": "npm run test:release && git push --follow-tags && gh release create \"v$(node -p \"require('./package.json').version\")\" --verify-tag --title \"v$(node -p \"require('./package.json').version\")\" --generate-notes",
    "version": "npm run format && git add -A src",
    "postversion": "git push --follow-tags",
    "size": "size-limit",
    "analyze": "rollup -c --config-option analyze=true"
  },
  "keywords": [
    "react",
    "media",
    "feed",
    "vertical",
    "tiktok",
    "instagram",
    "reels",
    "youtube",
    "shorts",
    "short-form-video",
    "video-feed",
    "swipe-feed",
    "scroll-snap",
    "infinite-scroll",
    "scroll",
    "component",
    "video"
  ],
  "author": "reinaldosimoes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reinaldosimoes/react-vertical-feed.git"
  },
  "bugs": {
    "url": "https://github.com/reinaldosimoes/react-vertical-feed/issues"
  },
  "homepage": "https://github.com/reinaldosimoes/react-vertical-feed#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.1",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.1",
    "@rollup/plugin-typescript": "^11.0.0",
    "@size-limit/file": "^11.2.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^4.0.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.9.6",
    "rollup": "^3.30.0",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-visualizer": "^5.12.0",
    "size-limit": "^11.2.0",
    "standard-version": "^9.5.0",
    "ts-jest": "^29.4.12",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "10 KB"
    },
    {
      "path": "dist/index.mjs",
      "limit": "10 KB"
    }
  ]
}
